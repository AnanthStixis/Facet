# ---------------------------------------------------------------------------
# Facet - environment configuration
# Copy to .env and adjust. Never commit .env.
#
# Targets a locally installed PostgreSQL. There is no Docker anywhere in this
# project; see infra/bootstrap.sql for the one-time database setup.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true

# Product identity. Every user-facing surface reads these, so rebranding is a
# one-file change once the final product name is signed off.
PRODUCT_NAME=Facet
PRODUCT_TAGLINE=Every relationship has more than one side.
VENDOR_NAME=Stixis AI Solutions

# --- Database -------------------------------------------------------------
# The API connects as facet_app, a non-owner role, so row level security is
# actually enforced. Migrations connect as the owner.
DATABASE_URL=postgresql+asyncpg://facet_app:facet_app_local_password@localhost:5432/facet
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/facet
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Rate limiting / job state -------------------------------------------
# Leave REDIS_URL empty to use the in-process limiter, which is correct for a
# single-worker local run. Set it in staging/production, where multiple workers
# must share one counter or the limit is per-worker and effectively useless.
REDIS_URL=

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_WITH_A_GENERATED_64_BYTE_URLSAFE_SECRET
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
INVITE_TOKEN_TTL_HOURS=72
FEEDBACK_LINK_TTL_DAYS=30
PASSWORD_MIN_LENGTH=12
MFA_REQUIRED_FOR_SUPER_ADMIN=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PUBLIC_APP_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:8010

# --- Email ----------------------------------------------------------------
# file  -> writes .eml files to backend/var/outbox and logs a preview path
# smtp  -> a real SMTP relay
# azure -> Azure Communication Services (production)
EMAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@facet.local
EMAIL_FROM_NAME=Facet

# --- Storage --------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=facet-assets
LOGO_MAX_BYTES=2097152

# --- AI (Module H) ---------------------------------------------------------
# The deterministic local analyser is the only provider — nothing here to
# point at an external model.
AI_MONTHLY_TOKEN_BUDGET_PER_ORG=2000000
# Minimum responses before an AI summary is shown, so anonymous feedback
# cannot be de-anonymised by inference. Do not lower without a policy review.
AI_MIN_RESPONSES_FOR_SUMMARY=4

# --- Exports --------------------------------------------------------------
# Above this row count an export is queued and delivered as a signed link.
EXPORT_SYNC_ROW_LIMIT=5000
EXPORT_HARD_ROW_LIMIT=250000
