# ---------------------------------------------------------------------------
# Facet - docker compose environment.
# Copy to .env.docker and adjust. Never commit .env.docker.
#
# Values here override the defaults baked into docker-compose.yml. Anything
# not listed here (Postgres image, ports, volumes) is set directly in the
# compose file's `environment` blocks — see .env.example for a description
# of each backend setting.
# ---------------------------------------------------------------------------

ENVIRONMENT=staging
DEBUG=false

PRODUCT_NAME=Facet
PRODUCT_TAGLINE=Every relationship has more than one side.
VENDOR_NAME=Stixis AI Solutions

# --- Postgres (used by the db service and by DATABASE_URL/ALEMBIC_DATABASE_URL below)
POSTGRES_DB=facet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432

# The API connects as facet_app (created by infra/bootstrap.sql); migrations
# connect as the postgres owner. Hostname is the compose service name "db".
DATABASE_URL=postgresql+asyncpg://facet_app:facet_app_local_password@db:5432/facet
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres123@db:5432/facet
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Shared across backend replicas via the redis service.
REDIS_URL=redis://redis:6379/0

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_ME_WITH_A_GENERATED_64_BYTE_URLSAFE_SECRET
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
INVITE_TOKEN_TTL_HOURS=72
FEEDBACK_LINK_TTL_DAYS=30
PASSWORD_MIN_LENGTH=12
MFA_REQUIRED_FOR_SUPER_ADMIN=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900
COOKIE_SECURE=true
COOKIE_DOMAIN=

# --- CORS / public URLs ----------------------------------------------------
# Frontend is served on FRONTEND_PORT (default 5174) and proxies /api to the
# backend container, so the browser only ever sees one origin.
CORS_ORIGINS=http://localhost:5174
PUBLIC_APP_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:5174/api

# --- Ports exposed on the host --------------------------------------------
BACKEND_PORT=8010
FRONTEND_PORT=5174

# --- Email ------------------------------------------------------------
EMAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@facet.local
EMAIL_FROM_NAME=Facet

# --- Storage ----------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=facet-assets
LOGO_MAX_BYTES=2097152

# --- AI ---------------------------------------------------------------
AI_MONTHLY_TOKEN_BUDGET_PER_ORG=2000000
AI_MIN_RESPONSES_FOR_SUMMARY=4

# --- Exports ------------------------------------------------------------
EXPORT_SYNC_ROW_LIMIT=5000
EXPORT_HARD_ROW_LIMIT=250000
